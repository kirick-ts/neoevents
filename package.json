{
	"name": "neoevents",
	"version": "0.3.1",
	"description": "Type-safe EventEmitter",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"unpkg": "dist/main.min.mjs",
	"jsdelivr": "dist/main.min.mjs",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/node": "^22.14.1",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.25",
		"tsdown": "0.23.0",
		"type-fest": "4.41.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"vitest": "5.0.3"
	},
	"scripts": {
		"build": "tsdown",
		"check": "lint && bun run test && bun run build",
		"test": "bun test && vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirick-ts/neoevents.git"
	},
	"keywords": [
		"events",
		"eventtarget",
		"eventemitter",
		"emitter",
		"customevent",
		"typescript",
		"typesafe",
		"typed-events"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kirick-ts/neoevents/issues"
	},
	"homepage": "https://github.com/kirick-ts/neoevents#readme"
}
